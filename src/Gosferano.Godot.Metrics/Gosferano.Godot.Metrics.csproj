<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Information -->
    <PackageId>Gosferano.Godot.Metrics</PackageId>
    <Version>0.1.0</Version>
    <Authors>gosferano</Authors>
    <Company>gosferano</Company>
    <Description>Shows System.Diagnostics.Metrics instruments as Godot custom monitors.</Description>
    <PackageTags>godot;godot4;metrics;diagnostics;monitors;opentelemetry;csharp</PackageTags>

    <PackageProjectUrl>https://github.com/gosferano/godot-metrics</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gosferano/godot-metrics</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gosferano.Godot.Metrics.Tests" />
  </ItemGroup>

</Project>
